{
  "name": "FamilyPulse (.NET 10)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp"
      ]
    }
  },
  "postCreateCommand": "dotnet tool install --global dotnet-ef || true && dotnet restore",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "FamilyPulse API",
      "onAutoForward": "notify"
    }
  }
}